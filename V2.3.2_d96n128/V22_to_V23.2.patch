+    const int tile = plan_fwd_tile_for_params(params);
     HEADDIM_SWITCH(params.d, [&] {
         BOOL_SWITCH(params.is_causal, Is_causal, [&] {
-                run_mha_fwd_<kHeadDim, Is_causal>(params);
+            dispatch_mha_fwd_tile<kHeadDim, Is_causal>(params, tile);
         });
     });
 }
