+// ---------------------------------------------------------------------------------------------
+// V2.3.2 forward tile selection.
+// SMALLM=1 compiles M64 (4 warps), SMALLM=2 also compiles M32 (2 warps).
+// D96_M64_N128 adds a separate D96 / M64 / N128 experiment (tile id 65).
+// Automatic shape profiles are deliberately gated to the exact fixed-length CMP 40HX
+// benchmark profiles (34 SMs, B1H4 and B2H8). Unmeasured shapes use the generic wave model.
+// Mode 0 = automatic; 128/64/32 force M; 65 forces D96 M64 N128 only.
+// ---------------------------------------------------------------------------------------------
+#ifdef FLASH_TURING_SMALLM
+static constexpr int kFwdTileCompiled = FLASH_TURING_SMALLM;
+#else
+static constexpr int kFwdTileCompiled = 0;
+#endif
+#ifdef FLASH_TURING_D96_M64_N128
+static constexpr int kFwdTileD96M64N128Compiled = 1;
+#else
+static constexpr int kFwdTileD96M64N128Compiled = 0;
+#endif
+static std::atomic<int> g_fwd_tile_mode{0};
+// Kept for unprofiled shapes only. The CMP 40HX profiles below are empirical choices.
+static std::atomic<int> g_fwd_tile_fixed_cost{48};
+
+static inline int device_sm_count() {
+    static std::atomic<int> cache[16];
+    int dev = 0;
+    C10_CUDA_CHECK(cudaGetDevice(&dev));
+    if (dev >= 0 && dev < 16) {
+        const int cached = cache[dev].load(std::memory_order_relaxed);
+        if (cached > 0) return cached;
+    }
+    int sms = 0;
+    C10_CUDA_CHECK(cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, dev));
+    if (sms <= 0) sms = 1;
+    if (dev >= 0 && dev < 16) cache[dev].store(sms, std::memory_order_relaxed);
+    return sms;
+}
+
+static inline int plan_fwd_tile_wave_model(const int b, const int seqlen_q,
+                                            const int h, const int sms) {
+    if (kFwdTileCompiled <= 0) return 128;
+    const long long safe_sms = sms > 0 ? sms : 1;
+    const long long bh = static_cast<long long>(b) * static_cast<long long>(h);
+    const long long fixed = g_fwd_tile_fixed_cost.load(std::memory_order_relaxed);
+    int best = 128;
+    long long best_cost = LLONG_MAX;
+    const int candidates[3] = {128, 64, 32};
+    for (int t : candidates) {
+        if (t == 64 && kFwdTileCompiled < 1) continue;
+        if (t == 32 && kFwdTileCompiled < 2) continue;
+        const long long ctas = ((static_cast<long long>(seqlen_q) + t - 1) / t) * bh;
+        const long long waves = (ctas + safe_sms - 1) / safe_sms;
+        const long long cost = waves * (t + fixed);
+        if (cost < best_cost) { best_cost = cost; best = t; }
+    }
+    return best;
+}
+
+// Empirical policy from the full M128/M64/M32 sweep on CMP 40HX (34 SMs).
+// Returns -1 outside the exact shapes that were measured. Causal and non-causal
+// are separate because D96/D128 and D32 show material causal-dependent winners.
+static inline int plan_fwd_tile_cmp40hx_profile(const int b, const int h,
+                                                 const int d, const int s,
+                                                 const bool causal) {
+    if (b == 1 && h == 4 && (s == 128 || s == 256 || s == 512)) {
+        switch (d) {
+            case 32: return s <= 256 ? 32 : 64;
+            case 64: return 64;
+            case 96: return (!causal && s <= 256) ? 32 : 64;
+            case 128: return (!causal && s == 128) ? 32 : 64;
+            default: return -1;
+        }
+    }
+    if (b == 2 && h == 8 && (s == 128 || s == 256 || s == 512 || s == 1024)) {
+        if (s == 128) return 64;
+        switch (d) {
+            case 32: return (s == 256 && !causal) ? 128 : 64;
+            case 64:
+            case 96: return 128;
+            case 128: return (causal && s >= 512) ? 64 : 128;
+            default: return -1;
+        }
+    }
+    return -1;
+}
+
+static inline int plan_fwd_tile_for_params(const Flash_fwd_params &params) {
+    const int mode = g_fwd_tile_mode.load(std::memory_order_relaxed);
+    if (mode != 0) return mode;
+    if (kFwdTileCompiled <= 0) return 128;
+
+    const int sms = device_sm_count();
+    const bool fixed_full_sequence = params.cu_seqlens_q == nullptr &&
+                                     params.cu_seqlens_k == nullptr &&
+                                     params.seqlen_q == params.seqlen_k;
+    if (sms == 34 && fixed_full_sequence) {
+        const int profiled = plan_fwd_tile_cmp40hx_profile(
+            params.b, params.h, params.d, params.seqlen_q, params.is_causal);
+        if (profiled > 0) {
+            if (profiled == 32 && kFwdTileCompiled < 2) return 64;
+            if (profiled == 64 && kFwdTileCompiled < 1) return 128;
+            return profiled;
+        }
+    }
+    return plan_fwd_tile_wave_model(params.b, params.seqlen_q, params.h, sms);
+}
+
+static inline int plan_fwd_tile_shape(const int b, const int seqlen_q,
+                                       const int h, const int d, const bool causal) {
+    Flash_fwd_params params{};
+    params.b = b;
+    params.seqlen_q = seqlen_q;
+    params.seqlen_k = seqlen_q;
+    params.h = h;
+    params.d = d;
+    params.is_causal = causal;
+    return plan_fwd_tile_for_params(params);
+}
+
+// Compatibility API retained for callers that only know B/S/H. It uses the generic model.
+static inline int plan_fwd_tile(const int b, const int seqlen_q, const int h) {
+    const int mode = g_fwd_tile_mode.load(std::memory_order_relaxed);
+    if (mode != 0) return mode;
+    return plan_fwd_tile_wave_model(b, seqlen_q, h, device_sm_count());
+}
+
+static void set_fwd_tile_mode(const int mode) {
+    TORCH_CHECK(mode == 0 || mode == 128 || mode == 64 || mode == 32 || mode == 65,
+                "fwd tile mode must be 0 (auto), 128, 64, 32, or 65 (D96 M64 N128)");
+    TORCH_CHECK(mode != 64 || kFwdTileCompiled >= 1,
+                "kBlockM=64 kernels were not compiled (build with FLASH_TURING_SMALLM=1 or 2)");
+    TORCH_CHECK(mode != 32 || kFwdTileCompiled >= 2,
+                "kBlockM=32 kernels were not compiled (build with FLASH_TURING_SMALLM=2)");
+    TORCH_CHECK(mode != 65 || (kFwdTileCompiled >= 1 && kFwdTileD96M64N128Compiled),
+                "D96 M64 N128 kernel was not compiled (set FLASH_TURING_D96_M64_N128=1)");
+    g_fwd_tile_mode.store(mode, std::memory_order_relaxed);
+}
+
+static void set_fwd_tile_fixed_cost(const int cost) {
+    TORCH_CHECK(cost >= 0 && cost <= 4096, "fixed cost must be in [0, 4096]");
+    g_fwd_tile_fixed_cost.store(cost, std::memory_order_relaxed);
+}
+
+// Keep preprocessor conditionals outside HEADDIM_SWITCH / BOOL_SWITCH macro arguments.
+template <int Headdim, bool Is_causal>
+static inline void dispatch_mha_fwd_tile(Flash_fwd_params &params, const int tile) {
+#if defined(FLASH_TURING_D96_M64_N128)
+    if (tile == 65) {
+        if constexpr (Headdim == 96) {
+            run_mha_fwd_tile_<96, Is_causal, 64, 128>(params);
+            return;
+        } else {
+            TORCH_CHECK(false, "tile mode 65 is only valid for head dimension 96");
+            return;
+        }
+    }
+#endif
+    (void)tile;
+#ifdef FLASH_TURING_SMALLM
+    if (tile == 64) {
+        run_mha_fwd_tile_<Headdim, Is_causal, 64>(params);
+        return;
+    }
+#if FLASH_TURING_SMALLM >= 2
+    if (tile == 32) {
+        run_mha_fwd_tile_<Headdim, Is_causal, 32>(params);
+        return;
+    }
+#endif
+#endif
+    run_mha_fwd_<Headdim, Is_causal>(params);
+}
+
