+// Empirical policy from the full M128/M64/M32 sweep on CMP 40HX (34 SMs).
+// Returns -1 outside the exact shapes that were measured. Causal and non-causal
+// are separate because D96/D128 and D32 show material causal-dependent winners.
+static inline int plan_fwd_tile_cmp40hx_profile(const int b, const int h,
+                                                 const int d, const int s,
+                                                 const bool causal) {
+    if (b == 1 && h == 4 && (s == 128 || s == 256 || s == 512)) {
+        switch (d) {
+            case 32: return s <= 256 ? 32 : 64;
+            case 64: return 64;
+            case 96: return (!causal && s <= 256) ? 32 : 64;
+            case 128: return (!causal && s == 128) ? 32 : 64;
+            default: return -1;
+        }
+    }
+    if (b == 2 && h == 8 && (s == 128 || s == 256 || s == 512 || s == 1024)) {
+        if (s == 128) return 64;
+        switch (d) {
+            case 32: return (s == 256 && !causal) ? 128 : 64;
+            case 64:
+            case 96: return 128;
+            case 128: return (causal && s >= 512) ? 64 : 128;
+            default: return -1;
+        }
+    }
+    return -1;
