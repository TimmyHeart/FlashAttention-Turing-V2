diff --git a/test_flashattn_guardrails.py b/test_flashattn_guardrails.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b30e651994fe780a83f1c923f9070fb976579d8
--- /dev/null
+++ b/test_flashattn_guardrails.py
@@ -0,0 +1,169 @@
+#!/usr/bin/env python3
+"""Supplemental CUDA tests for the A+B+C+D guardrail branch.
+
+Run after building/installing the extension in the target Windows environment:
+    py -3.12 test_flashattn_guardrails.py
+
+Covers cases absent from the original 72-case suite: Q/K length mismatch,
+causal Q>K zero rows, B>1, non-contiguous views with stride(-1)==1, and
+unsupported head-dimension rejection.
+"""
+from __future__ import annotations
+
+import math
+import traceback
+
+import torch
+
+from flash_attention_interface import flash_attn_func
+import flash_attn_turing as flash_attn_gpu
+
+
+ATOL = 8e-3
+RTOL = 8e-3
+RESULTS: list[tuple[str, bool, str]] = []
+
+
+def reference_attention(q, k, v, causal: bool):
+    """FP32 attention reference matching this fork's bottom-right causal mask."""
+    hq, hk = q.shape[2], k.shape[2]
+    if hq % hk:
+        raise ValueError(f"Hq={hq} must be divisible by Hk={hk}")
+    if hq != hk:
+        ratio = hq // hk
+        k = k.repeat_interleave(ratio, dim=2)
+        v = v.repeat_interleave(ratio, dim=2)
+
+    qf = q.float().transpose(1, 2)
+    kf = k.float().transpose(1, 2)
+    vf = v.float().transpose(1, 2)
+    scores = torch.matmul(qf, kf.transpose(-2, -1)) / math.sqrt(q.shape[-1])
+
+    if causal:
+        sq, sk = q.shape[1], k.shape[1]
+        qi = torch.arange(sq, device=q.device)[:, None]
+        ki = torch.arange(sk, device=q.device)[None, :]
+        allowed = (ki - qi) <= (sk - sq)
+        scores = scores.masked_fill(~allowed[None, None, :, :], float("-inf"))
+        has_any = allowed.any(dim=-1)[None, None, :, None]
+        scores = torch.where(has_any, scores, torch.zeros_like(scores))
+        probs = torch.softmax(scores, dim=-1)
+        probs = probs.masked_fill(~allowed[None, None, :, :], 0.0)
+    else:
+        probs = torch.softmax(scores, dim=-1)
+    return torch.matmul(probs, vf).transpose(1, 2).to(q.dtype)
+
+
+def compare(actual, expected, label: str):
+    if not torch.isfinite(actual).all():
+        raise AssertionError(f"{label}: actual contains NaN/Inf")
+    if not torch.isfinite(expected).all():
+        raise AssertionError(f"{label}: reference contains NaN/Inf")
+    diff = (actual.float() - expected.float()).abs()
+    max_err = diff.max().item() if diff.numel() else 0.0
+    if not torch.allclose(actual, expected, atol=ATOL, rtol=RTOL):
+        raise AssertionError(f"{label}: max_abs={max_err:.7g}")
+    return max_err
+
+
+def run_fwd_bwd_case(name: str, q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, causal: bool):
+    q = q.detach().requires_grad_(True)
+    k = k.detach().requires_grad_(True)
+    v = v.detach().requires_grad_(True)
+    out = flash_attn_func(q, k, v, causal=causal)
+
+    qr = q.detach().clone().requires_grad_(True)
+    kr = k.detach().clone().requires_grad_(True)
+    vr = v.detach().clone().requires_grad_(True)
+    ref = reference_attention(qr, kr, vr, causal)
+    fwd_err = compare(out, ref, name + " forward")
+
+    grad_out = torch.randn_like(out)
+    got = torch.autograd.grad(out, (q, k, v), grad_outputs=grad_out)
+    want = torch.autograd.grad(ref, (qr, kr, vr), grad_outputs=grad_out)
+    grad_errs = [compare(a, b, f"{name} {tag}") for tag, a, b in zip(("dQ", "dK", "dV"), got, want)]
+    return f"forward_max={fwd_err:.6g}; grad_max={max(grad_errs):.6g}"
+
+
+def record(name: str, fn):
+    try:
+        detail = fn()
+        RESULTS.append((name, True, detail))
+        print(f"[PASS] {name} | {detail}")
+    except Exception:
+        detail = traceback.format_exc().strip().replace("\n", " | ")
+        RESULTS.append((name, False, detail))
+        print(f"[FAIL] {name} | {detail}")
+
+
+def main() -> int:
+    if not torch.cuda.is_available():
+        print("[FATAL] CUDA is not available; run this test on the SM75 target.")
+        return 2
+
+    device = "cuda"
+    dtype = torch.float16
+    torch.manual_seed(20261109)
+    torch.cuda.manual_seed_all(20261109)
+
+    # Q longer than K: verifies early-returned query blocks and zero-initialized output.
+    for causal in (False, True):
+        name = f"B2 D32 Q200 K64 causal={causal}"
+        def case_q_gt_k(causal=causal):
+            q = torch.randn(2, 200, 4, 32, device=device, dtype=dtype)
+            k = torch.randn(2, 64, 4, 32, device=device, dtype=dtype)
+            v = torch.randn_like(k)
+            detail = run_fwd_bwd_case(name, q, k, v, causal)
+            if causal:
+                # Under bottom-right causal alignment, the first 128 query rows have no legal key.
+                # Those rows must be explicitly zero, not uninitialized output memory.
+                out = flash_attn_func(q, k, v, causal=True)
+                if not torch.equal(out[:, :128], torch.zeros_like(out[:, :128])):
+                    raise AssertionError("fully masked leading query rows are not exactly zero")
+            return detail
+        record(name, case_q_gt_k)
+
+    # K longer than Q: checks the opposite length direction and its bottom-right mask offset.
+    for causal in (False, True):
+        name = f"B2 D32 Q64 K200 causal={causal}"
+        def case_k_gt_q(causal=causal):
+            q = torch.randn(2, 64, 4, 32, device=device, dtype=dtype)
+            k = torch.randn(2, 200, 4, 32, device=device, dtype=dtype)
+            v = torch.randn_like(k)
+            return run_fwd_bwd_case(name, q, k, v, causal)
+        record(name, case_k_gt_q)
+
+    # These views are non-contiguous but retain stride(-1)==1, the case the old wrapper missed.
+    name = "non-contiguous inputs with inner stride 1"
+    def case_noncontiguous():
+        qb = torch.randn(2, 4, 129, 32, device=device, dtype=dtype)
+        kb = torch.randn(2, 4, 129, 32, device=device, dtype=dtype)
+        vb = torch.randn(2, 4, 129, 32, device=device, dtype=dtype)
+        q, k, v = (x.transpose(1, 2) for x in (qb, kb, vb))
+        assert q.stride(-1) == 1 and not q.is_contiguous()
+        assert k.stride(-1) == 1 and not k.is_contiguous()
+        assert v.stride(-1) == 1 and not v.is_contiguous()
+        return run_fwd_bwd_case(name, q, k, v, causal=False)
+    record(name, case_noncontiguous)
+
+    name = "reject unsupported head dimension 48"
+    def case_unsupported_dim():
+        q = torch.randn(1, 16, 2, 48, device=device, dtype=dtype)
+        try:
+            flash_attn_gpu.fwd(q, q, q, 1.0 / math.sqrt(48), False)
+        except RuntimeError as exc:
+            if "Unsupported head dimension" not in str(exc):
+                raise AssertionError(f"unexpected error: {exc}") from exc
+            return "rejected with expected TORCH_CHECK"
+        raise AssertionError("head dimension 48 was not rejected")
+    record(name, case_unsupported_dim)
+
+    torch.cuda.synchronize()
+    passed = sum(ok for _, ok, _ in RESULTS)
+    failed = len(RESULTS) - passed
+    print(f"\nGUARDRAIL SUMMARY: PASS={passed} FAIL={failed} TOTAL={len(RESULTS)}")
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/bench_v2.py b/tools/bench_v2.py
new file mode 100644
index 0000000000000000000000000000000000000000..67f73e052cacf392175fa4d562373f460963bf5e
--- /dev/null
+++ b/tools/bench_v2.py
@@ -0,0 +1,200 @@
+"""
+A/B benchmark + quick correctness gate for the V2 speed variants (run on the Turing GPU).
+
+Per shape and head dim it prints, for FlashAttn-Turing and torch SDPA:
+  event ms  : CUDA-event time of back-to-back calls   (includes CPU launch gaps - what V1 reported)
+  graph ms  : same call replayed from a CUDA graph    (GPU time only - no Python/ATen/launch overhead)
+  kernels   : GPU ops per call (memsets + kernels), from torch.profiler
+If 'event' >> 'graph' the call is host/launch bound; if they match, the kernel itself is the limit.
+
+Correctness gate (--check, on by default): forward output and, with --bwd, dq/dk/dv versus an
+fp32 reference, using the same tolerance style as a fp16 attention test (max abs err).
+
+Typical use (build each variant into its own venv/site-packages or rebuild between runs):
+  python bench_v2.py --tag base      > base.txt
+  python bench_v2.py --tag sepv      > sepv.txt        # built with FLASH_TURING_SEPV=1
+  python bench_v2.py --tag sepv_fastsm > both.txt      # built with both flags
+"""
+import argparse
+import statistics
+from collections import Counter
+
+import torch
+import torch.nn.functional as F
+from torch.profiler import profile, ProfilerActivity
+
+from flash_attention_interface import flash_attn_func
+import flash_attn_turing as flash_attn_gpu
+
+
+def event_ms(fn, warmup=10, iters=50, rounds=5):
+    for _ in range(warmup):
+        fn()
+    torch.cuda.synchronize()
+    res = []
+    for _ in range(rounds):
+        s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        s.record()
+        for _ in range(iters):
+            fn()
+        e.record()
+        torch.cuda.synchronize()
+        res.append(s.elapsed_time(e) / iters)
+    return statistics.median(res)
+
+
+def graph_ms(fn, warmup=10, iters=50, rounds=5):
+    for _ in range(warmup):          # warm-up also performs one-time setup (smem attribute, allocator)
+        fn()
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for _ in range(10):
+            fn()
+    res = []
+    for _ in range(rounds):
+        s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        s.record()
+        for _ in range(iters // 10 or 1):
+            g.replay()
+        e.record()
+        torch.cuda.synchronize()
+        res.append(s.elapsed_time(e) / (10 * (iters // 10 or 1)))
+    return statistics.median(res)
+
+
+def gpu_ops_per_call(fn, iters=20):
+    for _ in range(5):
+        fn()
+    torch.cuda.synchronize()
+    with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA]) as prof:
+        for _ in range(iters):
+            fn()
+        torch.cuda.synchronize()
+    names = Counter(ev.name for ev in prof.events()
+                    if ev.device_type == torch.autograd.DeviceType.CUDA)
+    return sum(names.values()) / iters
+
+
+def ref_attn(q, k, v, causal, scale):
+    qf, kf, vf = (x.float().transpose(1, 2) for x in (q, k, v))       # B,H,S,D
+    hq, hk = qf.shape[1], kf.shape[1]
+    if hq != hk:
+        kf = kf.repeat_interleave(hq // hk, 1)
+        vf = vf.repeat_interleave(hq // hk, 1)
+    s = (qf @ kf.transpose(-1, -2)) * scale
+    if causal:
+        sq, sk = s.shape[-2:]
+        qi = torch.arange(sq, device=s.device)[:, None]
+        ki = torch.arange(sk, device=s.device)[None, :]
+        allowed = (ki - qi) <= (sk - sq)  # this fork uses bottom-right causal alignment
+        s = s.masked_fill(~allowed[None, None, :, :], float("-inf"))
+        has_any = allowed.any(dim=-1)[None, None, :, None]
+        # Avoid softmax(all -inf) -> NaN for query rows with no legal key.
+        s = torch.where(has_any, s, torch.zeros_like(s))
+        p = torch.softmax(s, -1).masked_fill(~allowed[None, None, :, :], 0.0)
+    else:
+        p = torch.softmax(s, -1)
+    return (p @ vf).transpose(1, 2)
+
+
+def check(d, b, sq, sk, h, hk, causal, bwd):
+    torch.manual_seed(0)
+    mk = lambda s, hh: torch.randn(b, s, hh, d, device="cuda", dtype=torch.float16, requires_grad=bwd)
+    q, k, v = mk(sq, h), mk(sk, hk), mk(sk, hk)
+    scale = d ** -0.5
+    out = flash_attn_func(q, k, v, causal=causal)
+    ref = ref_attn(q, k, v, causal, scale)
+    fwd_err = (out.float() - ref).abs().max().item()
+    msg = f"fwd max|err|={fwd_err:.2e}"
+    ok = fwd_err < 2e-2
+    if bwd:
+        g = torch.randn_like(out)
+        dq, dk, dv = torch.autograd.grad(out, (q, k, v), g)
+        rq, rk, rv = (x.detach().float().requires_grad_() for x in (q, k, v))
+        rr = ref_attn(rq, rk, rv, causal, scale)
+        gq, gk, gv = torch.autograd.grad(rr, (rq, rk, rv), g.float())
+        e = [(a.float() - r).abs().max().item() for a, r in ((dq, gq), (dk, gk), (dv, gv))]
+        msg += f" | dq/dk/dv max|err|={e[0]:.2e}/{e[1]:.2e}/{e[2]:.2e}"
+        ok = ok and max(e) < 5e-2
+    return ok, msg
+
+
+def benchmark_backward(d, b, s, heads, causal):
+    """Time the extension backward API separately from forward and report SDPA autograd."""
+    q, k, v = (torch.randn(b, s, h, d, device="cuda", dtype=torch.float16)
+               for h in (heads, heads, heads))
+    scale = d ** -0.5
+    # Prepare saved forward tensors outside the timed region.
+    out, lse = flash_attn_gpu.fwd(q, k, v, scale, causal)
+    dout = torch.randn_like(out)
+    fa_bwd = lambda: flash_attn_gpu.bwd(q, k, v, out, lse, dout, scale, causal)
+    fa_ms = event_ms(fa_bwd)
+    fa_ops = gpu_ops_per_call(fa_bwd)
+
+    # SDPA backward is measured on a retained prebuilt autograd graph.
+    qg, kg, vg = (x.detach().requires_grad_(True) for x in (q, k, v))
+    sd_out = F.scaled_dot_product_attention(
+        qg.transpose(1, 2), kg.transpose(1, 2), vg.transpose(1, 2),
+        is_causal=causal,
+    )
+    sd_grad = dout.transpose(1, 2).contiguous()
+    sd_bwd = lambda: torch.autograd.grad(
+        sd_out, (qg, kg, vg), grad_outputs=sd_grad, retain_graph=True,
+    )
+    sd_ms = event_ms(sd_bwd)
+    return fa_ms, sd_ms, fa_ops
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--tag", default="run")
+    ap.add_argument("--dims", type=int, nargs="+", default=[32, 64, 96, 128])
+    ap.add_argument("--seqs", type=int, nargs="+", default=[128, 256, 512, 1024, 2048])
+    ap.add_argument("--batches", type=int, nargs="+", default=[1, 4])
+    ap.add_argument("--heads", type=int, default=8)
+    ap.add_argument("--no-check", action="store_true")
+    ap.add_argument("--bwd", action="store_true", help="also check backward")
